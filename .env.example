# PayTwin OS — environment template. Copy to .env and fill in real values.
# NEVER commit .env (gitignored). Dev defaults below work out of the box.

PAYTWIN_ENV=development

# database (tests force sqlite; dev/demo default sqlite:///./data/demo.db)
# postgres via infra/docker-compose.yml:
PAYTWIN_DATABASE_URL=postgresql+psycopg://paytwin:paytwin_dev@localhost:5433/paytwin
# PAYTWIN_DATABASE_URL=sqlite:///./data/demo.db

# cache / pubsub seam (redis via compose on 6380)
PAYTWIN_REDIS_URL=redis://localhost:6380/0

# signing + auth secrets — CHANGE FOR ANY NON-LOCAL USE
PAYTWIN_SECRET_KEY=dev-secret-change-me

# connector webhook HMAC secrets (X-PayTwin-Signature: sha256=...)
PAYTWIN_WEBHOOK_SECRET_SIMULATOR=sim-secret-dev
PAYTWIN_WEBHOOK_SECRET_MOCKPROVIDER=mock-secret-dev
PAYTWIN_WEBHOOK_SECRET_RAZORPAY=rzp-secret-dev
# Razorpay Standard Checkout signature verification only; keep server-side.
# It is intentionally distinct from the webhook secret and is never accepted by the API/UI.
# This development default supports the credential-free local Razorpay-shaped
# Test Mode. Set a real Test Mode secret only through the server environment.
PAYTWIN_RAZORPAY_KEY_SECRET=rzp-checkout-secret-dev

# commander LLM seam (ADR-007): none = deterministic offline composer
PAYTWIN_LLM_PROVIDER=none
PAYTWIN_LLM_API_KEY=

# worker cadence (seconds)
PAYTWIN_WORKER_INTERVAL=30

# API rate limit — sliding window, requests/min per credential on /api/*
# (/webhooks/* and /api/health exempt). Excess returns 429 + Retry-After.
PAYTWIN_RATE_LIMIT_PER_MIN=240
